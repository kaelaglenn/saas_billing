{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./generator/billing_generator/truth.py)",
      "Read(./generator/billing_generator/messiness.py)",
      "Bash(*--target prod*)",
      "Bash(*--target=prod*)",
      "Bash(*-t prod*)",
      "Bash(gh pr merge *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block_prod_target.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/sqlfluff_lint.sh",
            "timeout": 180
          }
        ]
      }
    ]
  }
}

# Copy to .env (git-ignored) and fill in. direnv loads it via .envrc.

# Snowflake account identifier: SELECT CURRENT_ORGANIZATION_NAME() || '-' || CURRENT_ACCOUNT_NAME();
SNOWFLAKE_ACCOUNT=<ORG>-<ACCOUNT>

# Your own Snowflake user and the private key registered for it (snowflake/generate_keypair.sh <USER>)
SNOWFLAKE_USER=<YOUR_USER>
SNOWFLAKE_PRIVATE_KEY_PATH=/Users/<you>/.snowflake/keys/<YOUR_USER>.p8

# Your personal dev schema in ANALYTICS_DEV, e.g. DBT_JANE
DBT_SCHEMA=DBT_<YOURNAME>

# Loaded automatically by direnv (https://direnv.net) when you cd into this repo; unloaded when you leave.
# Shared instructions only. Personal values go in .env (git-ignored; template in .env.example).

# Use the project's Python environment, so `dbt`, `pytest`, etc. work without `uv run`.
export VIRTUAL_ENV="$PWD/.venv"
PATH_add .venv/bin

# Load personal settings (Snowflake account, user, key path, dev schema).
dotenv_if_exists .env

# Copy to .dlt/secrets.toml (git-ignored) and fill in.

[destination.snowflake.credentials]
host = "<ORG>-<ACCOUNT>"                                       # account identifier, e.g. ABCDEFG-XY12345
private_key_path = "/Users/<you>/.snowflake/keys/DLT_SVC.p8"   # absolute path from generate_keypair.sh
